# Copy this file to .env and fill in real values before deploying.
APP_NAME="Pollination & Apiary Manager"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_KEY=change-this-to-a-random-32-char-string

# MySQL 8.4. DB_HOST/DB_PORT are overridden to point at the "db" container
# when running under docker-compose (see docker-compose.yml).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=apiary_manager
DB_USERNAME=apiary_app
DB_PASSWORD=change-this-password
DB_ROOT_PASSWORD=change-this-root-password

# Business setting: mites per 100 bees above which a hive is "over threshold"
MITE_THRESHOLD=3

# Company branding (config/company.php falls back to bracketed placeholders if unset)
COMPANY_NAME="[Company Name]"
COMPANY_TAGLINE="[Company tagline]"
COMPANY_ADDRESS="[Street Address, City, State ZIP]"
COMPANY_PHONE="[(555) 010-0000]"
COMPANY_EMAIL="[info@example.com]"
COMPANY_WEBSITE="[www.example.com]"
COMPANY_LOGO=/assets/img/logo-placeholder.svg

# Demo sign-in passwords (used only by database/seed.php)
DEMO_ADMIN_PASSWORD=AdminDemo!2026
DEMO_MANAGER_PASSWORD=ManagerDemo!2026
DEMO_FIELD_TECH_PASSWORD=FieldDemo!2026
